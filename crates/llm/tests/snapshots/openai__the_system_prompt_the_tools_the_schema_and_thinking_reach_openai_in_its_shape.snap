---
source: crates/llm/tests/openai.rs
expression: "endpoint.received()[0].body"
---
{
  "model": "gpt-6-luna",
  "stream": true,
  "messages": [
    {
      "role": "system",
      "content": "You are the Advisor. Choose only among the Candidate Actions."
    },
    {
      "role": "user",
      "content": "Build: Minotaur Fighter, XL 9.\n\nThreat Level: DANGEROUS. Candidate Actions: fight, upstairs."
    }
  ],
  "max_completion_tokens": 800,
  "stream_options": {
    "include_usage": true
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "lookup",
        "description": "Game Knowledge facts about a monster, item or spell.",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "answer",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "pick": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "pick",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "reasoning_effort": "medium"
}
